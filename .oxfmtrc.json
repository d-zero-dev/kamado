{
	"arrowParens": "always",
	"bracketSameLine": true,
	"bracketSpacing": true,
	"jsxSingleQuote": false,
	"printWidth": 90,
	"quoteProps": "as-needed",
	"semi": true,
	"singleQuote": true,
	"tabWidth": 2,
	"trailingComma": "all",
	"useTabs": true,
	"overrides": [
		{
			"files": ["*.html"],
			"options": {
				"printWidth": 320
			}
		}
	],
	"ignorePatterns": [
		"**/CHANGELOG.md",
		"**/dist/**",
		"**/target/**",
		"yarn.lock",
		"Cargo.lock",
		".claude/settings.local.json",
		".claude/worktrees/**",
		"crates/kd_jsonc/tests/edit_golden.json",
		"crates/kd_jsonc/tests/edit_array_golden.json",
		"packages/*/oracle/**",
		"packages/@kamado-io/*/fixtures/**",
		"benchmarks/v2-baseline/**"
	],
	"sortPackageJson": false
}
