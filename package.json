{
	"name": "kamado-monorepo",
	"description": "Bake your HTML hard. The on-demand static site generator.",
	"repository": "https://github.com/d-zero-dev/kamado.git",
	"author": "D-ZERO Co., Ltd.",
	"license": "MIT",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "lerna run build",
		"dev": "lerna run dev",
		"test": "vitest run --test-timeout 60000",
		"lint": "run-s lint:oxlint lint:stylelint lint:markuplint lint:oxfmt lint:textlint lint:rustfmt lint:clippy",
		"lint:check": "run-s lint:oxlint:check lint:stylelint:check lint:markuplint:check lint:oxfmt:check lint:textlint:check lint:rustfmt:check lint:clippy",
		"lint:oxlint": "oxlint --type-aware --disable-nested-config --fix .",
		"lint:oxlint:check": "oxlint --type-aware --disable-nested-config .",
		"lint:stylelint": "stylelint --fix \"packages/**/*.css\"",
		"lint:stylelint:check": "stylelint \"packages/**/*.css\"",
		"lint:markuplint": "markuplint --fix --no-allow-warnings \"packages/kamado/client/**/*.{tsx,jsx,html}\"",
		"lint:markuplint:check": "markuplint --no-allow-warnings \"packages/kamado/client/**/*.{tsx,jsx,html}\"",
		"lint:oxfmt": "oxfmt --write \"{*,**/*}.{md,mdc,json,js,cjs,mjs,jsx,ts,cts,mts,tsx,css,html,yml,yaml}\"",
		"lint:oxfmt:check": "oxfmt --check \"{*,**/*}.{md,mdc,json,js,cjs,mjs,jsx,ts,cts,mts,tsx,css,html,yml,yaml}\"",
		"lint:textlint": "textlint --fix \"{*,./**/*}.{md,mdc}\" && textlint \"{*,./**/*}.{md,mdc}\"",
		"lint:textlint:check": "textlint \"{*,./**/*}.{md,mdc}\"",
		"lint:rustfmt": "cargo fmt --all",
		"lint:rustfmt:check": "cargo fmt --all -- --check",
		"lint:clippy": "cargo clippy --locked --offline --all-targets -- -D warnings",
		"release": "node scripts/release.mjs --exact --conventional-commits --conventional-graduate --no-push",
		"release:alpha": "node scripts/release.mjs --exact --force-publish --conventional-commits --conventional-prerelease --preid alpha --no-push",
		"release:beta": "node scripts/release.mjs --exact --force-publish --conventional-commits --conventional-prerelease --preid beta --no-push",
		"release:rc": "node scripts/release.mjs --exact --force-publish --conventional-commits --conventional-prerelease --preid rc --no-push",
		"postinstall": "husky",
		"commit": "npx cz",
		"co": "npx cz",
		"update": "yarn upgrade-interactive"
	},
	"workspaces": [
		"packages/*",
		"packages/@kamado-io/*"
	],
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-customizable"
		},
		"cz-customizable": {
			"config": "./node_modules/@d-zero/cz-config"
		}
	},
	"devDependencies": {
		"@d-zero/commitlint-config": "6.0.0-alpha.3",
		"@d-zero/eslint-config": "5.1.3",
		"@d-zero/lint-staged-config": "6.0.0-alpha.3",
		"@d-zero/markuplint-config": "6.0.0-alpha.3",
		"@d-zero/oxlint-config": "6.0.0-alpha.3",
		"@d-zero/oxlint-plugin": "6.0.0-alpha.3",
		"@d-zero/shared": "0.23.0",
		"@d-zero/stylelint-config": "6.0.0-alpha.3",
		"@d-zero/textlint-config": "6.0.0-alpha.3",
		"@d-zero/tsconfig": "2.0.0",
		"@markuplint/jsx-parser": "5.5.0",
		"@markuplint/pretenders": "5.5.0",
		"@markuplint/react-spec": "5.5.0",
		"@types/html-minifier-terser": "7.0.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"acorn": "8.19.0",
		"character-entities": "2.0.2",
		"cssnano": "8.0.2",
		"dayjs": "1.11.23",
		"esbuild": "0.28.2",
		"esbuild-v2": "npm:esbuild@0.28.1",
		"eslint": "9.39.5",
		"html-minifier-terser": "7.2.0",
		"husky": "9.1.7",
		"jsonc-parser": "3.3.1",
		"kamado-v2": "npm:kamado@2.0.0-alpha.17",
		"lerna": "10.1.1",
		"markuplint": "5.5.0",
		"mdn-data": "2.37.2",
		"npm-run-all2": "9.0.4",
		"oxfmt": "0.62.0",
		"oxlint": "1.91.0",
		"oxlint-tsgolint": "7.0.2005",
		"postcss": "8.5.25",
		"postcss-custom-media": "12.0.1",
		"postcss-import": "16.1.1",
		"prettier-v2": "npm:prettier@3.9.6",
		"pug-lexer": "5.0.1",
		"pug-parser": "6.0.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"stylelint": "17.16.0",
		"textlint": "15.8.0",
		"typescript": "6.0.3",
		"vitest": "4.1.12"
	},
	"resolutions": {
		"nx/undici": "8.12.4"
	},
	"packageManager": "yarn@4.18.1",
	"volta": {
		"node": "26.13.0",
		"yarn": "4.18.1"
	}
}
