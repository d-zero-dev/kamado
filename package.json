{
	"name": "kamado-monorepo",
	"description": "Bake your HTML hard. The on-demand static site generator.",
	"repository": "https://github.com/d-zero-dev/kamado.git",
	"author": "D-ZERO Co., Ltd.",
	"license": "MIT",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "lerna run build",
		"dev": "lerna run dev",
		"test": "vitest run --test-timeout 60000",
		"lint": "run-s lint:eslint lint:prettier lint:textlint lint:cspell",
		"lint:check": "run-s lint:eslint:check lint:prettier:check lint:textlint:check lint:cspell",
		"lint:cspell": "npx cspell --no-progress --show-suggestions \"**\"",
		"lint:eslint": "npx eslint --fix \"./{*,packages/**/src/{*,**/*}}.{ts,js,cjs,mjs}\"",
		"lint:eslint:check": "npx eslint \"./{*,packages/**/src/{*,**/*}}.{ts,js,cjs,mjs}\"",
		"lint:prettier": "npx prettier --write \"{*,./**/*}{.{md,mdc,mdx,js,jsx,ts,tsx,css,pug,html,json,yaml},*rc}\" \"!**/dist/**/*\"",
		"lint:prettier:check": "npx prettier --check \"{*,./**/*}{.{md,mdc,mdx,js,jsx,ts,tsx,css,pug,html,json,yaml},*rc}\" \"!**/dist/**/*\"",
		"lint:textlint": "npx textlint --fix \"{*,./**/*}.{md,mdc}\" && npx textlint \"{*,./**/*}.{md,mdc}\"",
		"lint:textlint:check": "npx textlint \"{*,./**/*}.{md,mdc}\"",
		"release": "node scripts/release.mjs --exact --conventional-commits --conventional-graduate --no-push",
		"release:alpha": "node scripts/release.mjs --exact --force-publish --conventional-commits --conventional-prerelease --preid alpha --no-push",
		"release:beta": "node scripts/release.mjs --exact --force-publish --conventional-commits --conventional-prerelease --preid beta --no-push",
		"release:rc": "node scripts/release.mjs --exact --force-publish --conventional-commits --conventional-prerelease --preid rc --no-push",
		"postinstall": "husky",
		"commit": "npx cz",
		"co": "npx cz",
		"update": "yarn upgrade-interactive"
	},
	"workspaces": [
		"packages/*"
	],
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-customizable"
		},
		"cz-customizable": {
			"config": "./node_modules/@d-zero/cz-config"
		}
	},
	"devDependencies": {
		"@d-zero/commitlint-config": "5.1.1",
		"@d-zero/cspell-config": "5.1.1",
		"@d-zero/eslint-config": "5.1.1",
		"@d-zero/lint-staged-config": "5.1.1",
		"@d-zero/prettier-config": "5.1.1",
		"@d-zero/shared": "0.23.0",
		"@d-zero/textlint-config": "5.1.1",
		"@d-zero/tsconfig": "2.0.0",
		"@types/html-minifier-terser": "7.0.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"acorn": "8.19.0",
		"character-entities": "2.0.2",
		"cssnano": "8.0.2",
		"dayjs": "1.11.23",
		"esbuild": "0.28.2",
		"esbuild-v2": "npm:esbuild@0.28.1",
		"html-minifier-terser": "7.2.0",
		"husky": "9.1.7",
		"kamado-v2": "npm:kamado@2.0.0-alpha.17",
		"lerna": "10.1.1",
		"mdn-data": "2.37.2",
		"npm-run-all2": "9.0.4",
		"postcss": "8.5.25",
		"postcss-custom-media": "12.0.1",
		"postcss-import": "16.1.1",
		"prettier": "3.9.10",
		"prettier-v2": "npm:prettier@3.9.6",
		"pug-lexer": "5.0.1",
		"pug-parser": "6.0.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"typescript": "6.0.3",
		"vitest": "5.0.5"
	},
	"resolutions": {
		"nx/undici": "7.30.1"
	},
	"packageManager": "yarn@4.18.1",
	"volta": {
		"node": "26.12.1",
		"yarn": "4.18.1"
	}
}
