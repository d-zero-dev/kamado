.DS_Store

node_modules
npm-error.log
package-lock.json
yarn-error.log
.yarn/install-state.gz
.yarn/build-state.yml

# ignore file types
*.zip
*.psd
*.ai
*.sql

*storybook.log

# claude
.claude/*.local.json

# build outputs
packages/**/dist/
packages/**/tsconfig.build.tsbuildinfo

# benchmark fixtures
packages/**/.bench/

# incremental build cache when kept in-tree via `--cache-dir .kamado/cache`
# (the default location is the OS temp dir; see packages/kamado/README.md)
.kamado/
