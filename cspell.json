{
	"import": ["@d-zero/cspell-config"],
	"ignorePaths": [
		"**/CHANGELOG.md",
		"**/CODEOWNERS",
		"crates/kd_html/src/entities_table.rs",
		// Differential test data: deliberately misspelled tags and names.
		"crates/kd_html/tests/golden/**",
		"scripts/html-golden-cases.mjs"
	],
	// NIST SHA-256 test vectors are long lowercase letter strings, not words.
	// Glob tests use short nonsense paths (abbbc, axxb, acdf, acef) to show
	// which alternatives expand; they are inputs, not words.
	"ignoreRegExpList": [
		"/\\b[a-z]{40,}\\b/",
		"/\\b(abbbc|axxb|acdf|acef|bxxxz|ampx|copyx|notit)\\b/"
	],
	"words": [
		//
		"amet",
		"ampb",
		"dedented",
