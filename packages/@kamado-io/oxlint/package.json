{
	"name": "@kamado-io/oxlint",
	"version": "3.0.0-alpha.6",
	"description": "Oxlint rules for the JSX of kamado: what a page that is rendered once to HTML cannot do",
	"repository": {
		"type": "git",
		"url": "https://github.com/d-zero-dev/kamado.git",
		"directory": "packages/@kamado-io/oxlint"
	},
	"author": "D-ZERO Co., Ltd.",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"dev": "tsc --watch --project tsconfig.build.json"
	},
	"files": [
		"dist"
	],
	"peerDependencies": {
		"eslint": ">=9.0.0",
		"oxlint": ">=1.77.0"
	},
	"peerDependenciesMeta": {
		"eslint": {
			"optional": true
		}
	},
	"devDependencies": {
		"eslint": "10.14.0",
		"oxlint": "1.91.0",
		"typescript": "6.0.3"
	},
	"engines": {
		"node": ">=24.11.0"
	}
}
